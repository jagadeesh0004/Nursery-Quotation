################################################################################
# 🔐 BACKEND ENVIRONMENT CONFIGURATION - EXAMPLE TEMPLATE
# Copy this file to .env and fill in actual values
# NEVER commit .env to git - only commit this .env.example file
################################################################################

# ================================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL via Supabase)
# ================================================================================
# Format: jdbc:postgresql://host:port/database
SPRING_DATASOURCE_URL=jdbc:postgresql://db.ymmbujskqowztgffqlmz.supabase.co:5432/postgres
# Database username
SPRING_DATASOURCE_USERNAME=postgres
# Database password - KEEP THIS SECRET!
SPRING_DATASOURCE_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# ================================================================================
# 2. SUPABASE OAUTH2 CONFIGURATION
# ================================================================================
# Supabase JWKS URI for JWT validation
SUPABASE_JWKS_URI=https://ymmbujskqowztgffqlmz.supabase.co/auth/v1/.well-known/jwks.json
# Supabase auth issuer
SUPABASE_ISSUER=https://ymmbujskqowztgffqlmz.supabase.co/auth/v1
# Supabase project ID
SUPABASE_PROJECT_ID=ymmbujskqowztgffqlmz
# Spring OAuth2 JWT issuer URI
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://ymmbujskqowztgffqlmz.supabase.co/auth/v1

# ================================================================================
# 3. SERVER CONFIGURATION
# ================================================================================
# Backend server port (default: 8090)
SERVER_PORT=8090

# ================================================================================
# 4. FRONTEND CONFIGURATION
# ================================================================================
# Frontend application URL for CORS and redirects
FRONTEND_URL=http://localhost:5173

# ================================================================================
# 5. CORS CONFIGURATION (comma-separated list of allowed origins)
# ================================================================================
# For development:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# For production, update to:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ================================================================================
# 6. FILE UPLOAD CONFIGURATION
# ================================================================================
# Root upload directory
UPLOAD_DIR=./uploads
# Logo uploads directory
LOGOS_DIR=./uploads/logos
# PDF exports directory
PDFS_DIR=./uploads/pdfs

# ================================================================================
# 7. PDF GENERATION CONFIGURATION
# ================================================================================
# Enable/disable PDF caching (default: false)
PDF_CACHE_ENABLED=false



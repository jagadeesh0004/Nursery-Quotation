################################################################################
# 🔐 FRONTEND ENVIRONMENT CONFIGURATION - EXAMPLE TEMPLATE
# Copy this file to .env and fill in actual values
# NEVER commit .env to git - only commit this .env.example file
################################################################################

# ================================================================================
# 1. SUPABASE CONFIGURATION
# ================================================================================
# Supabase project URL (public information)
VITE_SUPABASE_URL=https://ymmbujskqowztgffqlmz.supabase.co
# Supabase anonymous (public) key - Safe for frontend use
# Get this from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ================================================================================
# 2. BACKEND API CONFIGURATION
# ================================================================================
# Backend API base URL
# For development: http://localhost:8090/api
# For production: https://your-backend-domain.com/api
VITE_API_BASE_URL=http://localhost:8090/api

# ================================================================================
# 3. SUPABASE STORAGE CONFIGURATION
# ================================================================================
# Supabase storage prefix for localStorage keys
# This is used to identify and manage Supabase auth tokens in localStorage
VITE_SUPABASE_STORAGE_PREFIX=sb-ymmbujskqowztgffqlmz-

# ================================================================================
# 4. VITE DEV SERVER CONFIGURATION
# ================================================================================
# Frontend dev server port (default: 5173)
VITE_PORT=5173

# ================================================================================
# 5. GOOGLE OAUTH CONFIGURATION (Optional)
# ================================================================================
# Google OAuth 2.0 Client ID
# Get this from: Google Cloud Console > Credentials
# Note: Client ID is public information (not a secret)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here



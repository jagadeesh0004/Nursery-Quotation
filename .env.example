# ======== BACKEND CONFIGURATION ========

# Server
SERVER_PORT=8091

# Database (Supabase PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DB_HOST:5432/YOUR_DB_NAME
SPRING_DATASOURCE_USERNAME=YOUR_DB_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# Supabase OAuth2
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://YOUR_PROJECT_ID.supabase.co/auth/v1

# Supabase Configuration
SUPABASE_JWKS_URI=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://YOUR_PROJECT_ID.supabase.co/auth/v1
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Application URLs
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
LOGOS_DIR=./uploads/logos
PDFS_DIR=./uploads/pdfs

# PDF Caching
PDF_CACHE_ENABLED=false

# ======== FRONTEND CONFIGURATION ========

# Vite Port
VITE_PORT=5173

# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# API Base URL
VITE_API_BASE_URL=http://localhost:8091/api

